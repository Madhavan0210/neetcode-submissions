class Solution {
public:
    int findPoisonedDuration(vector<int>& t, int duration) {
          int res = 0;
        int n = t.size();

        for (int i = 0; i < n - 1; i++) {
            int d = t[i + 1] - t[i];
            res += (d > duration) ? duration : d;
        }

        return res + (n ? duration : 0);
    }
};
